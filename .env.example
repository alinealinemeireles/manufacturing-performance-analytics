# Copie para `.env` (que está no .gitignore e NUNCA deve ser versionado nem ir num pacote .zip)
# e ajuste ao seu servidor. O projeto usa autenticação do Windows (Trusted_Connection, definido em
# lib/db_lib.py) -- não há usuário/senha a guardar aqui. Se o seu SQL Server usar login SQL, guarde
# as credenciais num cofre/variável de ambiente, não neste arquivo.
SQLSERVER_HOST=localhost
SQLSERVER_DB=ManufacturingPerformanceAnalytics
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
