# Copie para `.env` (que está no .gitignore e NUNCA deve ser versionado nem ir num pacote .zip)
# e ajuste ao seu servidor. Por omissão o projeto usa autenticação do Windows (Trusted_Connection,
# lib/db_lib.py). Para login SQL (ex.: SQL Server em contentor Linux), defina SQLSERVER_USER e
# SQLSERVER_PASSWORD como VARIÁVEIS DE AMBIENTE -- a senha não deve ficar neste arquivo.
SQLSERVER_HOST=localhost
SQLSERVER_DB=ManufacturingPerformanceAnalytics
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
